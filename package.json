{
  "name": "commit-release-template",
  "private": true,
  "packageManager": "pnpm@12.10.0",
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "commitlint-plugin-tense": "^1.0.12",
    "husky": "^9.1.7",
    "semantic-release": "^25.0.9"
  },
  "scripts": {
    "prepare": "husky",
    "release:next": "semantic-release --dry-run --no-ci --branches develop --plugins @semantic-release/commit-analyzer,@semantic-release/release-notes-generator"
  },
  "version": "1.0.0"
}
